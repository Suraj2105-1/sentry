# Merchant's Adversarial Shadow — Environment Variables
# Copy this to .env and fill in your keys before running the backend

# ── Enhancement 1: LLM Adversarial Negotiation ─────────────────────────────
# Get free key at https://aistudio.google.com/app/apikey
# When set: adversarial_negotiation attack uses real Gemini-1.5-Flash LLM
# When absent: falls back to high-fidelity template (still functional)
GEMINI_API_KEY=

# ── Enhancement 3: Razorpay Integration ────────────────────────────────────
# Get test keys at https://dashboard.razorpay.com/app/keys (switch to Test mode)
# When set: vaccination scan creates a real Razorpay test order
# When absent: returns a correctly-shaped mock order (same JSON structure)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
